#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        clear_ble_setting {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <11 12>;
            layers = <1>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <13 14>;
        };

        BT1 {
            bindings = <&mkp MB1>;
            key-positions = <29 28>;
        };

        BT2 {
            bindings = <&mkp MB2>;
            key-positions = <28 27>;
        };

        capslock {
            bindings = <&kp CLCK>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        // エンコーダー：キー

        rot_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        // エンコーダー：マウススクロール 

        rot_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            tap-ms = <20>;
            bindings = <&msc>, <&msc>;
        };

        // エンコーダー：マウススクロール(MOVE_Y)

        scroll_move_y: sensor_rotate_msc_for_move_y {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_Y(20)>, <&msc MOVE_Y(-20)>;

            // tap-ms下限メモ Yの値で可変: Y(15) <81>, Y(20) <65>, Y(25) <49>

            tap-ms = <65>;
        };

        // エンコーダー：マウススクロール(MOVE_X)

        scroll_move_x: sensor_rotate_msc_for_move_x {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_X(20)>, <&msc MOVE_X(-20)>;

            // tap-ms下限メモ Xの値で可変: X(15) <81>, X(20) <65>, X(25) <49>

            tap-ms = <65>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC     &kp Q  &kp W         &kp E             &kp R        &kp T        &kp N1            &kp Y          &kp U      &kp I       &kp O       &kp P  &kp BSPC
&kp TAB     &kp A  &kp S         &kp D             &kp F        &kp G        &kp H             &kp J          &kp K      &kp L       &kp ENTER
&kp LSHIFT  &kp Z  &kp X         &kp C             &kp V        &kp B        &kp N             &kp M          &kp COMMA  &kp PERIOD  &kp RSHIFT
                   &kp LEFT_ALT  &kp LEFT_COMMAND  &lt 1 SPACE  &lt 2 SPACE  &kp LEFT_CONTROL  &kp BACKSPACE
            >;

            sensor-bindings = <&scroll_move_y>;

        };

        FUNCTION {
            bindings = <
&kp ESC     &kp NUMBER_1     &kp NUMBER_2       &kp NUMBER_3      &kp NUMBER_4  &kp N5       &kp N1             &kp NUMBER_6   &kp N7                &kp N8                 &kp N9      &kp N0  &kp BSPC
&kp TAB     &kp EXCLAMATION  &kp DOUBLE_QUOTES  &kp HASH          &kp DOLLAR    &kp PERCENT  &kp AMPERSAND      &kp SQT        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp ENTER
&kp LSHIFT  &kp PLUS         &kp MINUS          &kp ASTERISK      &kp SLASH     &kp EQUAL    &kp TILDE          &kp QUESTION   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp RSHIFT
                             &kp LEFT_ALT       &kp LEFT_COMMAND  &none         &kp MINUS    &kp RIGHT_CONTROL  &kp BACKSPACE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;

        };

        NUM {
            bindings = <
&kp ESC     &kp F1        &kp F2        &kp F3             &kp F4          &kp F5        &kp N1          &kp F6          &kp F7              &kp F8               &kp F9      &kp F10  &kp BSPC
&kp TAB     &kp AT_SIGN   &kp GRAVE     &kp DOUBLE_QUOTES  &kp SEMICOLON   &kp COLON     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW        &kp RIGHT_ARROW      &kp ENTER
&kp LSHIFT  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2       &bt BT_SEL 3    &bt BT_SEL 4  &kp PIPE        &kp BACKSLASH   &kp RS(LEFT_BRACE)  &kp RS(RIGHT_BRACE)  &kp RSHIFT
                          &kp LGUI      &kp LCTRL          &kp UNDERSCORE  &none         &kp LALT        &kp N2
            >;
 
            sensor-bindings = <&rot_msc SCRL_UP SCRL_DOWN>;
           
        };

        ARROW {
            bindings = <
&kp ESC     &kp Q  &kp W     &kp E      &kp R        &kp T        &kp N1    &kp Y   &kp U      &kp I       &kp O       &kp P  &kp BSPC
&kp TAB     &kp A  &kp S     &kp D      &kp F        &kp G        &kp H     &kp J   &kp K      &kp L       &kp ENTER
&kp LSHIFT  &kp Z  &kp X     &kp C      &kp V        &kp B        &kp N     &kp M   &kp COMMA  &kp PERIOD  &kp RSHIFT
                   &kp LGUI  &kp LCTRL  &lt 1 SPACE  &lt 2 SPACE  &kp LALT  &kp N2
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;

        };

        MOUSE {
            bindings = <
&kp ESC     &kp Q  &kp W     &kp E      &kp R        &kp T        &kp N1    &kp Y   &kp U      &kp I       &kp O       &kp P  &kp BSPC
&kp TAB     &kp A  &kp S     &kp D      &kp F        &kp G        &kp H     &kp J   &kp K      &kp L       &kp ENTER
&kp LSHIFT  &kp Z  &kp X     &kp C      &mkp MB2     &mkp MB1     &kp N     &kp M   &kp COMMA  &kp PERIOD  &kp RSHIFT
                   &kp LGUI  &kp LCTRL  &lt 1 SPACE  &lt 2 SPACE  &kp LALT  &kp N2
            >;

            sensor-bindings = <&rot_msc SCRL_UP SCRL_DOWN>;

        };

        SCROLL {
            bindings = <
&kp ESC     &kp Q  &kp W     &kp E      &kp R        &kp T        &kp N1    &kp Y   &kp U      &kp I       &kp O       &kp P  &kp BSPC
&kp TAB     &kp A  &kp S     &kp D      &kp F        &kp G        &kp H     &kp J   &kp K      &kp L       &kp ENTER
&kp LSHIFT  &kp Z  &kp X     &kp C      &kp V        &kp B        &kp N     &kp M   &kp COMMA  &kp PERIOD  &kp RSHIFT
                   &kp LGUI  &kp LCTRL  &lt 1 SPACE  &lt 2 SPACE  &kp LALT  &kp N2
            >;

            sensor-bindings = <&rot_msc SCRL_UP SCRL_DOWN>;

        };

        layer_6 {
            bindings = <
&kp ESC     &kp Q  &kp W     &kp E      &kp R        &kp T        &kp N1    &kp Y   &kp U      &kp I       &kp O       &kp P  &kp BSPC
&kp TAB     &kp A  &kp S     &kp D      &kp F        &kp G        &kp H     &kp J   &kp K      &kp L       &kp ENTER
&kp LSHIFT  &kp Z  &kp X     &kp C      &kp V        &kp B        &kp N     &kp M   &kp COMMA  &kp PERIOD  &kp RSHIFT
                   &kp LGUI  &kp LCTRL  &lt 1 SPACE  &lt 2 SPACE  &kp LALT  &kp N2
            >;            
        };
    };
};